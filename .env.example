# Copy to .env.local and fill in real values. Never commit .env.local.
# Demo logins work without these, but change JWT_SECRET before going live.

# 32+ random characters — used to sign staff login sessions.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# MongoDB — the real database. Get a free one from MongoDB Atlas
# (https://cloud.mongodb.com): create a free M0 cluster, add a database
# user, allow your IP (or 0.0.0.0/0), then paste the connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medicore
# Leave empty to run in demo mode (seed data, browser-only saves).
# The database auto-seeds itself on first use; or run: npm run db:seed

MONGODB_URI=

# Live payments (SSLCommerz, same as Orderly). Leave empty for demo mode —
# bookings then use the simulated gateway and no real money moves.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" for sandbox testing, "false" for live merchant credentials.
SSLCOMMERZ_IS_SANDBOX=true

# Public site URL, used in payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
